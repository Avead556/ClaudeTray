
export struct Ring {
    percent: int,
    label: string,
    kind: int,
    critical: bool,
    more: int,
}

export struct LimitRow {
    title: string,
    reset: string,
    percent: int,
    kind: int,
    critical: bool,
}

export struct AccountItem {
    id: string,
    title: string,
    label: string,
    email: string,
    nickname: string,
    details: string,
    summary: string,
    initials: string,
    color: color,
    initials-color: color,
    active: bool,
    plan: string,
    plan-kind: int,
    state: int,
    rings: [Ring],
    limits: [LimitRow],
    session-percent: int,
    session-critical: bool,
    week-percent: int,
    week-critical: bool,
    remove-title: string,
}

export global Tr {
    in property <string> title: "Claude Code accounts";
    in property <string> add-account: "Add account";
    in property <string> add: "Add";
    in property <string> settings: "Settings";
    in property <string> settings-menu: "Settings…";
    in property <string> settings-title: "ClaudeTray Settings";
    in property <string> quit: "Quit ClaudeTray";
    in property <string> accounts: "Accounts";
    in property <string> general: "General";
    in property <string> open-at-login: "Open at login";
    in property <string> switch-next: "Switch to the next account";
    in property <string> press-shortcut: "Press a shortcut…";
    in property <string> shortcut-taken: "This shortcut is taken by another app — choose another";
    in property <string> on: "On";
    in property <string> off: "Off";
    in property <string> empty: "No accounts yet — sign in to Claude Code";
    in property <string> active: "Active";
    in property <string> active-account: "Active account";
    in property <string> remove-account: "Remove account";
    in property <string> remove: "Remove";
    in property <string> cancel: "Cancel";
    in property <string> remove-message: "The saved login will be removed from ClaudeTray. To use the account again, sign in to it again.";
    in property <string> show-limits: "Show limits";
    in property <string> hide-limits: "Hide limits";
    in property <string> session: "Session";
    in property <string> week: "Week";
    in property <string> default-color: "Default color";
    in property <string> login-expired: "Login expired — add the account again";
    in property <string> limits-unavailable: "Limits unavailable";
    in property <string> show-accounts: "Show accounts";
    in property <string> x11-only: "X11 only";
}

export global Colors {
    public pure function ring-win(kind: int, critical: bool) -> color {
        if (critical) {
            return #FF99A4;
        }
        return kind == 0 ? #FF9F0A : kind == 1 ? #60CDFF : #BF5AF2;
    }
    public pure function ring-linux(kind: int, critical: bool) -> color {
        if (critical) {
            return #FF7B63;
        }
        return kind == 0 ? #FFA348 : kind == 1 ? #78AEED : #DC8ADD;
    }
    public pure function badge-win(kind: int) -> color {
        return kind == 1 ? #FFD60A : kind == 2 ? #64D2FF : #ffffff9e;
    }
    public pure function badge-linux(kind: int) -> color {
        return kind == 1 ? #F8E45C : kind == 2 ? #99C1F1 : #ffffffa6;
    }
}

export global Icons {
    out property <string> plus: "M 8 2.5 L 8 13.5 M 2.5 8 L 13.5 8";
    out property <string> gear: "M 10.2 8 A 2.2 2.2 0 1 1 5.8 8 A 2.2 2.2 0 1 1 10.2 8 M 8 1.5 L 8 3.3 M 8 12.7 L 8 14.5 M 14.5 8 L 12.7 8 M 3.3 8 L 1.5 8 M 12.6 3.4 L 11.3 4.7 M 4.7 11.3 L 3.4 12.6 M 12.6 12.6 L 11.3 11.3 M 4.7 4.7 L 3.4 3.4";
    out property <string> power: "M 8 2 L 8 8 M 4.8 4.3 A 5 5 0 1 0 11.2 4.3";
    out property <string> trash: "M 3.4 4.6 L 12.6 4.6 M 6.3 4.6 L 6.3 3.4 Q 6.3 2.3 7.4 2.3 L 8.6 2.3 Q 9.7 2.3 9.7 3.4 L 9.7 4.6 M 6.9 7.4 L 6.9 10.9 M 9.1 7.4 L 9.1 10.9 M 4.6 4.6 L 5.1 12.6 Q 5.2 13.7 6.3 13.7 L 9.7 13.7 Q 10.8 13.7 10.9 12.6 L 11.4 4.6";
    out property <string> chevron: "M 6 3.5 L 10.5 8 L 6 12.5";
    out property <string> check: "M 3.5 8.5 L 6.5 11.5 L 12.5 4.5";
    out property <string> warning: "M 8 2.5 L 14 13 L 2 13 Z M 8 6.5 L 8 9.3 M 8 11.2 L 8 11.3";
    out property <string> offline: "M 2 6.2 Q 8 1.2 14 6.2 M 4.5 8.9 Q 8 6.2 11.5 8.9 M 7 11.6 Q 8 10.9 9 11.6 M 2.5 2.5 L 13.5 13.5";
}

component Glyph {
    in property <string> commands;
    in property <color> tint: #ffffff;
    in property <length> size: 16px;
    in property <length> thickness: 1.3px;
    in property <angle> rotation;
    width: size;
    height: size;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.commands;
        stroke: root.tint;
        stroke-width: root.thickness;
        stroke-line-cap: round;
        fill: transparent;
        transform-rotation: root.rotation;
    }
}

component Avatar inherits Rectangle {
    in property <AccountItem> item;
    in property <length> size: 32px;
    in property <int> weight: 600;
    width: size;
    height: size;
    border-radius: size / 2;
    background: item.color;
    Text {
        text: root.item.initials;
        font-size: root.size * 0.38;
        font-weight: root.weight;
        color: root.item.initials-color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component RingView {
    in property <Ring> ring;
    in property <bool> linux;
    property <color> tint: linux ? Colors.ring-linux(ring.kind, ring.critical) : Colors.ring-win(ring.kind, ring.critical);
    property <float> fraction: min(ring.percent, 100) / 100;
    property <length> line: linux ? 3px : 2.5px;
    width: 28px;
    height: 28px;
    Rectangle {
        width: 22px + root.line;
        height: self.width;
        border-radius: self.width / 2;
        border-width: root.line;
        border-color: #ffffff1a;
    }
    if root.ring.percent >= 100: Rectangle {
        width: 22px + root.line;
        height: self.width;
        border-radius: self.width / 2;
        border-width: root.line;
        border-color: root.tint;
    }
    if root.ring.percent > 0 && root.ring.percent < 100: Path {
        width: 28px;
        height: 28px;
        viewbox-width: 28;
        viewbox-height: 28;
        fill: transparent;
        stroke: root.tint;
        stroke-width: root.line;
        stroke-line-cap: round;
        commands: "M 14 3 A 11 11 0 " + (root.fraction > 0.5 ? "1" : "0") + " 1 " + (14 + 11 * sin(root.fraction * 360deg)) + " " + (14 - 11 * cos(root.fraction * 360deg));
    }
    Text {
        text: root.ring.label;
        font-size: root.ring.label.character-count > 2 ? 7px : 9px;
        font-weight: root.linux ? 700 : 600;
        color: root.ring.percent > 0 ? root.tint : #ffffff8c;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.ring.more > 0: Rectangle {
        x: parent.width - 12px;
        y: -3px;
        width: more.preferred-width + 6px;
        height: 11px;
        border-radius: 5.5px;
        background: root.linux ? #DC8ADD : #BF5AF2;
        more := Text {
            text: "+" + root.ring.more;
            font-size: 7px;
            font-weight: 700;
            color: #000000;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component Rings inherits HorizontalLayout {
    in property <AccountItem> item;
    in property <bool> linux;
    spacing: 4px;
    alignment: center;
    if root.item.state == 2: VerticalLayout {
        alignment: center;
        Glyph {
            commands: Icons.warning;
            tint: root.linux ? #FFA348 : #FF9F0A;
            accessible-role: image;
            accessible-label: Tr.login-expired;
        }
    }
    if root.item.state == 3: VerticalLayout {
        alignment: center;
        Glyph {
            commands: Icons.offline;
            tint: #ffffff8c;
            accessible-role: image;
            accessible-label: Tr.limits-unavailable;
        }
    }
    if root.item.state < 2: HorizontalLayout {
        spacing: 4px;
        for ring in root.item.rings: VerticalLayout {
            alignment: center;
            RingView {
                ring: ring;
                linux: root.linux;
            }
        }
    }
}

component UsageDetails inherits Rectangle {
    in property <AccountItem> item;
    in property <bool> linux;
    border-radius: linux ? 8px : 6px;
    background: #ffffff0a;
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        if root.item.state == 2 || root.item.state == 3 || root.item.state == 0: Text {
            text: root.item.state == 2 ? Tr.login-expired : Tr.limits-unavailable;
            font-size: 12px;
            color: #ffffff9e;
            wrap: word-wrap;
        }
        for limit in root.item.limits: VerticalLayout {
            spacing: 4px;
            property <color> tint: root.linux ? Colors.ring-linux(limit.kind, limit.critical) : Colors.ring-win(limit.kind, limit.critical);
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: limit.title;
                    font-size: 12px;
                    color: #ffffff;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if limit.reset != "": Text {
                    text: limit.reset;
                    font-size: 11px;
                    color: #ffffff8c;
                }
                Text {
                    text: limit.percent + "%";
                    font-size: 12px;
                    font-weight: 600;
                    min-width: 32px;
                    horizontal-alignment: right;
                    color: limit.percent > 0 ? tint : #ffffff8c;
                }
            }
            Rectangle {
                height: 3px;
                border-radius: 1.5px;
                background: #ffffff14;
                Rectangle {
                    x: 0;
                    width: parent.width * min(limit.percent, 100) / 100;
                    height: 100%;
                    border-radius: 1.5px;
                    background: tint;
                }
            }
        }
    }
}

component IssueBanner inherits Rectangle {
    in property <string> message;
    in property <string> restore-label;
    in property <bool> linux;
    callback restore();
    border-radius: linux ? 8px : 4px;
    background: #FF9F0A1f;
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: start;
                Glyph {
                    commands: Icons.warning;
                    tint: #FF9F0A;
                }
            }
            Text {
                text: root.message;
                font-size: 12px;
                color: #ffffff;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
        if root.restore-label != "": HorizontalLayout {
            alignment: start;
            Rectangle {
                height: 28px;
                width: restore-text.preferred-width + 24px;
                border-radius: root.linux ? 6px : 4px;
                background: restore-touch.has-hover ? #ffffff1f : #ffffff14;
                accessible-role: button;
                accessible-label: root.restore-label;
                restore-text := Text {
                    text: root.restore-label;
                    font-size: 12px;
                    color: #ffffff;
                }
                restore-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.restore();
                    }
                }
            }
        }
    }
}

component ChevronButton {
    in-out property <bool> expanded;
    width: 20px;
    height: 32px;
    accessible-role: button;
    accessible-label: expanded ? Tr.hide-limits : Tr.show-limits;
    Glyph {
        size: 14px;
        commands: Icons.chevron;
        tint: root.expanded || touch.has-hover ? #ffffffbf : #ffffff66;
        rotation: root.expanded ? 90deg : 0deg;
        animate rotation { duration: 150ms; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.expanded = !root.expanded;
        }
    }
}


export component Tray inherits SystemTrayIcon {
    in property <image> image: @image-url("tray.png");
    in property <string> tip;
    callback activated();
    callback show-accounts();
    callback open-settings();
    callback quit();
    icon: root.image;
    tooltip: root.tip;
    visible: true;
    clicked => {
        root.activated();
    }
    Menu {
        MenuItem {
            title: Tr.show-accounts;
            activated => {
                root.show-accounts();
            }
        }
        MenuItem {
            title: Tr.settings-menu;
            activated => {
                root.open-settings();
            }
        }
        MenuSeparator { }
        MenuItem {
            title: Tr.quit;
            activated => {
                root.quit();
            }
        }
    }
}


component WinBadge inherits Rectangle {
    in property <string> plan;
    in property <int> kind;
    property <color> tint: Colors.badge-win(kind);
    height: 16px;
    width: badge-text.preferred-width + 10px;
    border-radius: 3px;
    border-width: 1px;
    border-color: tint.with-alpha(0.4);
    badge-text := Text {
        text: root.plan;
        font-size: 10px;
        font-weight: 600;
        color: root.tint;
    }
}

component WinAccountRow {
    in property <AccountItem> item;
    callback clicked();
    property <bool> expanded;
    VerticalLayout {
        spacing: 4px;
        Rectangle {
            height: 52px;
            border-radius: 4px;
            background: root.item.active ? #ffffff0f : touch.has-hover ? #ffffff0a : transparent;
            accessible-role: button;
            accessible-label: root.item.title;
            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.clicked();
                }
            }
            if root.item.active: Rectangle {
                x: 2px;
                width: 3px;
                height: 16px;
                border-radius: 1.5px;
                background: #60CDFF;
            }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 4px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Avatar {
                        item: root.item;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.item.title;
                        font-size: 13px;
                        color: #ffffff;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        if root.item.label != "": Text {
                            text: root.item.label;
                            font-size: 12px;
                            color: #ffffff9e;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        if root.item.plan != "": VerticalLayout {
                            alignment: center;
                            WinBadge {
                                plan: root.item.plan;
                                kind: root.item.plan-kind;
                            }
                        }
                    }
                }
                Rings {
                    item: root.item;
                }
                VerticalLayout {
                    alignment: center;
                    ChevronButton {
                        expanded <=> root.expanded;
                    }
                }
            }
        }
        if root.expanded: HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-bottom: 4px;
            UsageDetails {
                item: root.item;
            }
        }
    }
}

component WinFooterButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    callback clicked();
    height: 32px;
    width: row.preferred-width;
    border-radius: 4px;
    border-width: 1px;
    border-color: #ffffff14;
    background: touch.pressed ? #ffffff0a : touch.has-hover ? #ffffff14 : #ffffff0f;
    accessible-role: button;
    accessible-label: label;
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Glyph {
                size: 12px;
                commands: root.icon;
            }
        }
        Text {
            text: root.label;
            font-size: 13px;
            color: #ffffff;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component WinIconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    callback clicked();
    width: 36px;
    height: 32px;
    border-radius: 4px;
    background: touch.pressed ? #ffffff0a : touch.has-hover ? #ffffff0f : transparent;
    accessible-role: button;
    accessible-label: label;
    Glyph {
        commands: root.icon;
        thickness: 1.2px;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component WinPopover inherits Window {
    in property <[AccountItem]> accounts;
    in property <string> issue;
    in property <string> restore-label;
    in property <string> hotkey;
    out property <length> content-height: body.preferred-height;
    callback switch(string);
    callback restore();
    callback add();
    callback settings();
    callback quit();
    callback key(string) -> bool;
    callback resized();
    title: "ClaudeTray popover";
    no-frame: true;
    always-on-top: true;
    background: #2c2c2c;
    default-font-family: "Segoe UI";
    width: 348px;
    height: body.preferred-height;
    forward-focus: keys;
    changed content-height => {
        root.resized();
    }
    keys := FocusScope {
        key-pressed(event) => {
            return root.key(event.text) ? accept : reject;
        }
        body := VerticalLayout {
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 14px;
                padding-bottom: 10px;
                spacing: 8px;
                Text {
                    text: Tr.title;
                    font-size: 14px;
                    font-weight: 600;
                    color: #ffffff;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if root.hotkey != "": Text {
                    text: root.hotkey;
                    font-size: 12px;
                    color: #ffffff9e;
                    vertical-alignment: center;
                }
            }
            if root.issue != "": HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-bottom: 8px;
                IssueBanner {
                    message: root.issue;
                    restore-label: root.restore-label;
                    restore => {
                        root.restore();
                    }
                }
            }
            if root.accounts.length == 0: Text {
                text: Tr.empty;
                font-size: 12px;
                color: #ffffff9e;
                horizontal-alignment: center;
                wrap: word-wrap;
                height: 48px;
                vertical-alignment: center;
            }
            VerticalLayout {
                padding-left: 6px;
                padding-right: 6px;
                padding-bottom: 8px;
                spacing: 2px;
                for item in root.accounts: WinAccountRow {
                    item: item;
                    clicked => {
                        root.switch(item.id);
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: #ffffff0f;
            }
            Rectangle {
                background: #202020;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 8px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 4px;
                    WinFooterButton {
                        label: Tr.add-account;
                        icon: Icons.plus;
                        clicked => {
                            root.add();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    WinIconButton {
                        icon: Icons.gear;
                        label: Tr.settings;
                        clicked => {
                            root.settings();
                        }
                    }
                    WinIconButton {
                        icon: Icons.power;
                        label: Tr.quit;
                        clicked => {
                            root.quit();
                        }
                    }
                }
            }
        }
    }
}

component WinToggle inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled();
    width: 40px;
    height: 20px;
    border-radius: 10px;
    background: checked ? #60CDFF : transparent;
    border-width: 1px;
    border-color: checked ? #60CDFF : #ffffff9e;
    opacity: enabled ? 1 : 0.4;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-label: label;
    Rectangle {
        width: root.checked ? 12px : 10px;
        height: self.width;
        border-radius: self.width / 2;
        x: root.checked ? parent.width - self.width - 4px : 4px;
        background: root.checked ? #000000 : #ffffffcc;
        animate x { duration: 120ms; }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.toggled();
        }
    }
}

component WinCard inherits Rectangle {
    background: #2b2b2b;
    border-radius: 4px;
    border-width: 1px;
    border-color: #00000033;
}

component ColorPicker inherits Rectangle {
    in property <[color]> palette;
    in property <bool> linux;
    callback pick(int);
    background: linux ? #383838 : #2c2c2c;
    border-radius: linux ? 12px : 8px;
    border-width: 1px;
    border-color: #ffffff1a;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000080;
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 6px;
            for swatch[index] in root.palette: Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: swatch;
                border-width: swatch-touch.has-hover ? 2px : 0;
                border-color: #ffffff;
                swatch-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.pick(index);
                    }
                }
            }
        }
        Rectangle {
            height: 28px;
            border-radius: root.linux ? 6px : 4px;
            background: default-touch.has-hover ? #ffffff14 : #ffffff0a;
            Text {
                text: Tr.default-color;
                font-size: 12px;
                color: #ffffff;
            }
            default-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.pick(-1);
                }
            }
        }
    }
}

component NameField {
    in property <AccountItem> item;
    in property <length> font-size: 14px;
    callback rename(string);
    height: 20px;
    name := TextInput {
        text: root.item.nickname;
        font-size: root.font-size;
        color: #ffffff;
        single-line: true;
        vertical-alignment: center;
        accessible-label: root.item.email;
        accepted => {
            root.rename(self.text);
            self.clear-focus();
        }
        changed has-focus => {
            if (!self.has-focus) {
                root.rename(self.text);
            }
        }
    }
    if name.text == "": Text {
        text: root.item.email;
        font-size: root.font-size;
        color: name.has-focus ? #ffffff66 : #ffffff;
        vertical-alignment: center;
        overflow: elide;
        width: 100%;
    }
}

component UsageBar {
    in property <string> title;
    in property <int> percent;
    in property <bool> critical;
    in property <int> kind;
    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            Text {
                text: root.title;
                font-size: 11px;
                color: #ffffff9e;
                horizontal-stretch: 1;
            }
            Text {
                text: root.percent + "%";
                font-size: 11px;
                color: #ffffff;
            }
        }
        Rectangle {
            height: 4px;
            border-radius: 2px;
            background: #ffffff1a;
            Rectangle {
                x: 0;
                width: parent.width * min(root.percent, 100) / 100;
                height: 100%;
                border-radius: 2px;
                background: Colors.ring-win(root.kind, root.critical);
            }
        }
    }
}

component WinAccountCard inherits WinCard {
    in property <AccountItem> item;
    in property <[color]> palette;
    callback rename(string);
    callback remove();
    callback set-color(int);
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Avatar {
                item: root.item;
                accessible-role: button;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        colors.show();
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            NameField {
                item: root.item;
                rename(text) => {
                    root.rename(text);
                }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                if root.item.details != "": Text {
                    text: root.item.details;
                    font-size: 12px;
                    color: #ffffff9e;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if root.item.plan != "": VerticalLayout {
                    alignment: center;
                    WinBadge {
                        plan: root.item.plan;
                        kind: root.item.plan-kind;
                    }
                }
            }
        }
        VerticalLayout {
            width: 120px;
            alignment: center;
            spacing: 6px;
            UsageBar {
                title: Tr.session;
                percent: root.item.session-percent;
                critical: root.item.session-critical;
                kind: 0;
            }
            UsageBar {
                title: Tr.week;
                percent: root.item.week-percent;
                critical: root.item.week-critical;
                kind: 1;
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 4px;
                background: trash.has-hover && !root.item.active ? #ffffff0f : transparent;
                accessible-role: button;
                accessible-label: Tr.remove-account;
                Glyph {
                    commands: Icons.trash;
                    tint: root.item.active ? #ffffff4d : #ffffffbf;
                    thickness: 1.2px;
                }
                trash := TouchArea {
                    enabled: !root.item.active;
                    mouse-cursor: pointer;
                    clicked => {
                        root.remove();
                    }
                }
            }
        }
    }
    colors := PopupWindow {
        x: 12px;
        y: 50px;
        ColorPicker {
            palette: root.palette;
            pick(index) => {
                root.set-color(index);
            }
        }
    }
}

component Keycap inherits Rectangle {
    in property <string> label;
    in property <bool> linux;
    height: 20px;
    width: cap.preferred-width + 12px;
    border-radius: 4px;
    background: #ffffff14;
    border-width: 1px;
    border-color: #ffffff1f;
    cap := Text {
        text: root.label;
        font-size: 11px;
        font-weight: root.linux ? 700 : 400;
        color: #ffffff;
    }
}

component ShortcutField {
    in property <[string]> keys;
    in property <bool> enabled;
    in property <bool> linux;
    in-out property <bool> recording;
    callback record(string, bool, bool, bool, bool) -> bool;
    height: 22px;
    width: row.preferred-width;
    opacity: enabled ? 1 : 0.5;
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (!root.recording) {
                return reject;
            }
            if (event.text == Key.Escape) {
                root.recording = false;
                return accept;
            }
            if (root.record(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta)) {
                root.recording = false;
            }
            return accept;
        }
        changed has-focus => {
            if (!self.has-focus) {
                root.recording = false;
            }
        }
        row := HorizontalLayout {
            spacing: 4px;
            alignment: start;
            if root.recording: Text {
                text: Tr.press-shortcut;
                font-size: 12px;
                color: root.linux ? #78AEED : #60CDFF;
                vertical-alignment: center;
            }
            if !root.recording: HorizontalLayout {
                spacing: 4px;
                for key in root.keys: Keycap {
                    label: key;
                    linux: root.linux;
                }
            }
        }
        TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                root.recording = true;
                focus.focus();
            }
        }
    }
}

component ConfirmDialog inherits Rectangle {
    in property <string> heading;
    in property <bool> linux;
    callback confirm();
    callback cancel();
    background: #00000099;
    TouchArea { }
    Rectangle {
        width: 380px;
        height: dialog.preferred-height;
        background: root.linux ? #383838 : #2b2b2b;
        border-radius: root.linux ? 12px : 8px;
        border-width: 1px;
        border-color: #ffffff14;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000099;
        dialog := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text {
                text: root.heading;
                font-size: 16px;
                font-weight: root.linux ? 700 : 600;
                color: #ffffff;
                wrap: word-wrap;
            }
            Text {
                text: Tr.remove-message;
                font-size: 13px;
                color: #ffffffbf;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Rectangle {
                    height: 32px;
                    width: cancel-text.preferred-width + 28px;
                    border-radius: root.linux ? 6px : 4px;
                    background: cancel-touch.has-hover ? #ffffff1f : #ffffff14;
                    accessible-role: button;
                    accessible-label: Tr.cancel;
                    cancel-text := Text {
                        text: Tr.cancel;
                        font-size: 13px;
                        color: #ffffff;
                    }
                    cancel-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.cancel();
                        }
                    }
                }
                Rectangle {
                    height: 32px;
                    width: remove-text.preferred-width + 28px;
                    border-radius: root.linux ? 6px : 4px;
                    background: root.linux ? (remove-touch.has-hover ? #E01B24 : #C01C28) : (remove-touch.has-hover ? #D13438 : #C42B1C);
                    accessible-role: button;
                    accessible-label: Tr.remove;
                    remove-text := Text {
                        text: Tr.remove;
                        font-size: 13px;
                        font-weight: root.linux ? 700 : 400;
                        color: #ffffff;
                    }
                    remove-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.confirm();
                        }
                    }
                }
            }
        }
    }
}

export component WinSettings inherits Window {
    in property <[AccountItem]> accounts;
    in property <[color]> palette;
    in property <bool> autostart-available;
    in property <bool> autostart;
    in property <bool> hotkeys-available;
    in property <bool> hotkey-enabled;
    in property <[string]> hotkey-keys;
    in property <bool> hotkey-failed;
    in property <bool> linux-x11-note;
    in-out property <string> removing-id;
    in-out property <string> removing-title;
    callback add();
    callback remove(string);
    callback rename(string, string);
    callback set-color(string, int);
    callback toggle-autostart();
    callback toggle-hotkey();
    callback record-hotkey(string, bool, bool, bool, bool) -> bool;
    callback quit();
    property <bool> recording;
    title: Tr.settings-title;
    icon: @image-url("../assets/icon.png");
    background: #202020;
    default-font-family: "Segoe UI";
    width: 600px;
    height: content.preferred-height;
    content := VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 16px;
        padding-bottom: 20px;
        spacing: 4px;
        Text {
            text: Tr.settings;
            font-size: 20px;
            font-weight: 600;
            color: #ffffff;
        }
        Rectangle {
            height: 8px;
        }
        HorizontalLayout {
            height: 40px;
            Text {
                text: Tr.accounts;
                font-size: 14px;
                font-weight: 600;
                color: #ffffff;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 32px;
                    width: add-text.preferred-width + 24px;
                    border-radius: 4px;
                    background: add-touch.pressed ? #4CC2FF : add-touch.has-hover ? #56C8FF : #60CDFF;
                    accessible-role: button;
                    accessible-label: Tr.add-account;
                    add-text := Text {
                        text: Tr.add-account;
                        font-size: 13px;
                        color: #000000;
                    }
                    add-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.add();
                        }
                    }
                }
            }
        }
        if root.accounts.length == 0: WinCard {
            height: 56px;
            Text {
                text: Tr.empty;
                font-size: 13px;
                color: #ffffff9e;
            }
        }
        for item in root.accounts: WinAccountCard {
            item: item;
            palette: root.palette;
            rename(text) => {
                root.rename(item.id, text);
            }
            remove => {
                root.removing-id = item.id;
                root.removing-title = item.remove-title;
            }
            set-color(index) => {
                root.set-color(item.id, index);
            }
        }
        Rectangle {
            height: 16px;
        }
        Text {
            text: Tr.general;
            font-size: 14px;
            font-weight: 600;
            color: #ffffff;
        }
        Rectangle {
            height: 4px;
        }
        WinCard {
            height: 52px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 16px;
                Text {
                    text: Tr.open-at-login;
                    font-size: 14px;
                    color: #ffffff;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.autostart ? Tr.on : Tr.off;
                    horizontal-stretch: 0;
                    font-size: 13px;
                    color: #ffffffbf;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    WinToggle {
                        checked: root.autostart;
                        enabled: root.autostart-available;
                        label: Tr.open-at-login;
                        toggled => {
                            root.toggle-autostart();
                        }
                    }
                }
            }
        }
        WinCard {
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 16px;
                VerticalLayout {
                    spacing: 6px;
                    horizontal-stretch: 1;
                    Text {
                        text: Tr.switch-next;
                        font-size: 14px;
                        color: #ffffff;
                    }
                    ShortcutField {
                        keys: root.hotkey-keys;
                        enabled: root.hotkey-enabled && root.hotkeys-available;
                        recording <=> root.recording;
                        record(text, control, alt, shift, meta) => {
                            return root.record-hotkey(text, control, alt, shift, meta);
                        }
                    }
                    if root.hotkey-enabled && root.hotkey-failed: Text {
                        text: Tr.shortcut-taken;
                        font-size: 12px;
                        color: #FCE100;
                        wrap: word-wrap;
                    }
                }
                Text {
                    text: root.hotkey-enabled ? Tr.on : Tr.off;
                    horizontal-stretch: 0;
                    font-size: 13px;
                    color: #ffffffbf;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    WinToggle {
                        checked: root.hotkey-enabled;
                        enabled: root.hotkeys-available;
                        label: Tr.switch-next;
                        toggled => {
                            root.toggle-hotkey();
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            padding-top: 12px;
            alignment: end;
            Text {
                text: Tr.quit;
                font-size: 12px;
                color: quit-touch.has-hover ? #99EBFF : #60CDFF;
                accessible-role: button;
                quit-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.quit();
                    }
                }
            }
        }
    }
    if root.removing-id != "": ConfirmDialog {
        width: 100%;
        height: 100%;
        heading: root.removing-title;
        cancel => {
            root.removing-id = "";
        }
        confirm => {
            root.remove(root.removing-id);
            root.removing-id = "";
        }
    }
}


component AdwBadge inherits Rectangle {
    in property <string> plan;
    in property <int> kind;
    property <color> tint: Colors.badge-linux(kind);
    height: 16px;
    width: badge-text.preferred-width + 14px;
    border-radius: 8px;
    background: tint.with-alpha(0.14);
    badge-text := Text {
        text: root.plan;
        font-size: 10px;
        font-weight: 700;
        color: root.tint;
    }
}

component LinuxAccountRow {
    in property <AccountItem> item;
    callback clicked();
    property <bool> expanded;
    VerticalLayout {
        spacing: 4px;
        Rectangle {
            height: 50px;
            border-radius: 6px;
            background: root.item.active ? #ffffff14 : touch.has-hover ? #ffffff0d : transparent;
            accessible-role: button;
            accessible-label: root.item.title;
            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.clicked();
                }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 6px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Avatar {
                        item: root.item;
                        weight: 700;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.item.title;
                        font-size: 14px;
                        color: #ffffff;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        if root.item.label != "": Text {
                            text: root.item.label;
                            font-size: 12px;
                            color: #ffffffa6;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        if root.item.plan != "": VerticalLayout {
                            alignment: center;
                            AdwBadge {
                                plan: root.item.plan;
                                kind: root.item.plan-kind;
                            }
                        }
                    }
                }
                Rings {
                    item: root.item;
                    linux: true;
                }
                VerticalLayout {
                    alignment: center;
                    width: 16px;
                    if root.item.active: Glyph {
                        commands: Icons.check;
                        thickness: 1.6px;
                        accessible-role: image;
                        accessible-label: Tr.active-account;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    ChevronButton {
                        expanded <=> root.expanded;
                    }
                }
            }
        }
        if root.expanded: HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            padding-bottom: 4px;
            UsageDetails {
                item: root.item;
                linux: true;
            }
        }
    }
}

component AdwMenuButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 36px;
    border-radius: 6px;
    background: touch.has-hover ? #ffffff14 : transparent;
    accessible-role: button;
    accessible-label: label;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.label;
            font-size: 14px;
            color: #ffffff;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component LinuxPopover inherits Window {
    in property <[AccountItem]> accounts;
    in property <string> issue;
    in property <string> restore-label;
    in property <string> hotkey;
    out property <length> content-height: body.preferred-height;
    callback switch(string);
    callback restore();
    callback add();
    callback settings();
    callback quit();
    callback key(string) -> bool;
    callback resized();
    title: "ClaudeTray popover";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Cantarell";
    width: 340px;
    height: body.preferred-height;
    forward-focus: keys;
    changed content-height => {
        root.resized();
    }
    Rectangle {
        background: #383838;
        border-radius: 12px;
        border-width: 1px;
        border-color: #0000004d;
    }
    keys := FocusScope {
        key-pressed(event) => {
            return root.key(event.text) ? accept : reject;
        }
        body := VerticalLayout {
            padding: 6px;
            Text {
                text: Tr.title;
                font-size: 13px;
                font-weight: 700;
                color: #ffffffb3;
                overflow: elide;
                height: 30px;
                vertical-alignment: center;
                x: 10px;
            }
            if root.issue != "": HorizontalLayout {
                padding-bottom: 6px;
                IssueBanner {
                    message: root.issue;
                    restore-label: root.restore-label;
                    linux: true;
                    restore => {
                        root.restore();
                    }
                }
            }
            if root.accounts.length == 0: Text {
                text: Tr.empty;
                font-size: 13px;
                color: #ffffffa6;
                horizontal-alignment: center;
                wrap: word-wrap;
                height: 48px;
                vertical-alignment: center;
            }
            VerticalLayout {
                spacing: 2px;
                for item in root.accounts: LinuxAccountRow {
                    item: item;
                    clicked => {
                        root.switch(item.id);
                    }
                }
            }
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                padding-top: 6px;
                padding-bottom: 6px;
                Rectangle {
                    height: 1px;
                    background: #ffffff1a;
                }
            }
            AdwMenuButton {
                label: Tr.add-account + "…";
                clicked => {
                    root.add();
                }
            }
            AdwMenuButton {
                label: Tr.settings;
                clicked => {
                    root.settings();
                }
            }
            AdwMenuButton {
                label: Tr.quit;
                clicked => {
                    root.quit();
                }
            }
        }
    }
}

component AdwSwitch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled();
    width: 48px;
    height: 26px;
    border-radius: 13px;
    background: checked ? #3584E4 : #ffffff26;
    opacity: enabled ? 1 : 0.5;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-label: label;
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        x: root.checked ? parent.width - 23px : 3px;
        background: #ffffff;
        drop-shadow-blur: 2px;
        drop-shadow-color: #0000004d;
        animate x { duration: 120ms; }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.toggled();
        }
    }
}

component AdwList inherits Rectangle {
    background: #383838;
    border-radius: 12px;
    border-width: 1px;
    border-color: #00000033;
    clip: true;
}

component LinuxAccountRowSettings {
    in property <AccountItem> item;
    in property <[color]> palette;
    in property <bool> last;
    callback rename(string);
    callback remove();
    callback set-color(int);
    VerticalLayout {
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 10px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Avatar {
                    item: root.item;
                    weight: 700;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            colors.show();
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                NameField {
                    item: root.item;
                    rename(text) => {
                        root.rename(text);
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: root.item.summary;
                        font-size: 12px;
                        color: #ffffffa6;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    if root.item.plan != "": VerticalLayout {
                        alignment: center;
                        AdwBadge {
                            plan: root.item.plan;
                            kind: root.item.plan-kind;
                        }
                    }
                }
            }
            if root.item.active: VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 22px;
                    width: active-text.preferred-width + 20px;
                    border-radius: 11px;
                    background: #8FF0A41f;
                    active-text := Text {
                        text: Tr.active;
                        font-size: 12px;
                        font-weight: 700;
                        color: #8FF0A4;
                    }
                }
            }
            if !root.item.active: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 6px;
                    background: trash.has-hover ? #ffffff14 : transparent;
                    accessible-role: button;
                    accessible-label: Tr.remove-account;
                    Glyph {
                        commands: Icons.trash;
                        tint: #FF7B63;
                        thickness: 1.3px;
                    }
                    trash := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.remove();
                        }
                    }
                }
            }
        }
        if !root.last: Rectangle {
            height: 1px;
            background: #00000040;
        }
    }
    colors := PopupWindow {
        x: 10px;
        y: 50px;
        ColorPicker {
            palette: root.palette;
            linux: true;
            pick(index) => {
                root.set-color(index);
            }
        }
    }
}

export component LinuxSettings inherits Window {
    in property <[AccountItem]> accounts;
    in property <[color]> palette;
    in property <bool> autostart-available;
    in property <bool> autostart;
    in property <bool> hotkeys-available;
    in property <bool> hotkey-enabled;
    in property <[string]> hotkey-keys;
    in property <bool> hotkey-failed;
    in property <bool> linux-x11-note;
    in-out property <string> removing-id;
    in-out property <string> removing-title;
    callback add();
    callback remove(string);
    callback rename(string, string);
    callback set-color(string, int);
    callback toggle-autostart();
    callback toggle-hotkey();
    callback record-hotkey(string, bool, bool, bool, bool) -> bool;
    callback quit();
    property <bool> recording;
    title: Tr.settings-title;
    icon: @image-url("../assets/icon.png");
    background: #242424;
    default-font-family: "Cantarell";
    width: 600px;
    height: content.preferred-height;
    content := VerticalLayout {
        padding-left: 32px;
        padding-right: 32px;
        padding-top: 20px;
        padding-bottom: 20px;
        spacing: 10px;
        HorizontalLayout {
            Text {
                text: Tr.accounts;
                font-size: 15px;
                font-weight: 700;
                color: #ffffff;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Rectangle {
                height: 30px;
                width: add-text.preferred-width + 28px;
                border-radius: 6px;
                background: add-touch.has-hover ? #3C8CE7 : #3584E4;
                accessible-role: button;
                accessible-label: Tr.add-account;
                add-text := Text {
                    text: Tr.add;
                    font-size: 14px;
                    font-weight: 700;
                    color: #ffffff;
                }
                add-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.add();
                    }
                }
            }
        }
        AdwList {
            VerticalLayout {
                if root.accounts.length == 0: Text {
                    text: Tr.empty;
                    font-size: 14px;
                    color: #ffffffa6;
                    height: 56px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                for item[index] in root.accounts: LinuxAccountRowSettings {
                    item: item;
                    palette: root.palette;
                    last: index == root.accounts.length - 1;
                    rename(text) => {
                        root.rename(item.id, text);
                    }
                    remove => {
                        root.removing-id = item.id;
                        root.removing-title = item.remove-title;
                    }
                    set-color(color-index) => {
                        root.set-color(item.id, color-index);
                    }
                }
            }
        }
        Rectangle {
            height: 14px;
        }
        Text {
            text: Tr.general;
            font-size: 15px;
            font-weight: 700;
            color: #ffffff;
        }
        AdwList {
            VerticalLayout {
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    height: 52px;
                    spacing: 12px;
                    Text {
                        text: Tr.open-at-login;
                        font-size: 14px;
                        color: #ffffff;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        AdwSwitch {
                            checked: root.autostart;
                            enabled: root.autostart-available;
                            label: Tr.open-at-login;
                            toggled => {
                                root.toggle-autostart();
                            }
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: #00000040;
                }
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        Text {
                            text: Tr.switch-next;
                            font-size: 14px;
                            color: #ffffff;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            ShortcutField {
                                keys: root.hotkey-keys;
                                enabled: root.hotkey-enabled && root.hotkeys-available;
                                linux: true;
                                recording <=> root.recording;
                                record(text, control, alt, shift, meta) => {
                                    return root.record-hotkey(text, control, alt, shift, meta);
                                }
                            }
                            if root.linux-x11-note: Text {
                                text: "· " + Tr.x11-only;
                                font-size: 12px;
                                color: #ffffffa6;
                                vertical-alignment: center;
                            }
                        }
                        if root.hotkey-enabled && root.hotkey-failed: Text {
                            text: Tr.shortcut-taken;
                            font-size: 12px;
                            color: #F8E45C;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        AdwSwitch {
                            checked: root.hotkey-enabled;
                            enabled: root.hotkeys-available;
                            label: Tr.switch-next;
                            toggled => {
                                root.toggle-hotkey();
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            padding-top: 6px;
            alignment: end;
            Text {
                text: Tr.quit;
                font-size: 13px;
                color: quit-touch.has-hover ? #99C1F1 : #78AEED;
                accessible-role: button;
                quit-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.quit();
                    }
                }
            }
        }
    }
    if root.removing-id != "": ConfirmDialog {
        width: 100%;
        height: 100%;
        heading: root.removing-title;
        linux: true;
        cancel => {
            root.removing-id = "";
        }
        confirm => {
            root.remove(root.removing-id);
            root.removing-id = "";
        }
    }
}
